# ONNX models (large binaries, re-exported via export_onnx.py)
stimme/models/emotion/*.onnx
stimme/models/emotion/*.onnx.data
stimme/models/embedding/onnx/*.onnx
stimme/models/embedding/onnx/*.onnx.data

